+// ownsRouteStatus reports whether this control plane should author status for a route.
+//
+// Ownership follows the route's PARENT, not the route's own istio.io/rev label or the one
+// it inherits from its namespace. Those two can disagree for the entire duration of a
+// revision-tag upgrade, because the tag on the ingress Gateway and the tags on application
+// namespaces are flipped in separate steps. While they disagree the prior behaviour is one
+// of two failures: no control plane writes status at all, or a control plane writes status
+// for a Gateway it does not manage and cannot program - which it will do even while that
+// Gateway's own control plane is not running.
+//
+// A mesh parent has no Gateway to derive ownership from, so it keeps the previous rule and
+// is claimed by the revision the route itself resolves to.
+//
+// This gates the status WRITE only. Config emission is deliberately left alone: dropping
+// config from a non-owning revision removed xDS from pods still on that revision and caused
+// an outage (istio/istio#59959).
+func (i RouteContextInputs) ownsRouteStatus(
+	krtctx krt.HandlerContext,
+	routeMeta metav1.ObjectMeta,
+	parents []routeParentReference,
+) bool {
+	tw := i.TagWatcher.Get(krtctx)
+	for _, p := range parents {
+		if p.IsMesh() {
+			if tw.IsMine(routeMeta) {
+				return true
+			}
+			continue
+		}
+		if p.ParentKey.Kind != gvk.KubernetesGateway {
+			continue
+		}
+		gw := ptr.Flatten(krt.FetchOne(krtctx, i.Gateways,
+			krt.FilterKey(p.ParentKey.Namespace+"/"+p.ParentKey.Name)))
+		if gw == nil {
+			continue
+		}
+		if tw.IsMine(gw.ObjectMeta) {
+			return true
+		}
+	}
+	return false
 }
 
